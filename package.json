{
  "name": "merchant-route",
  "version": "1.1.0",
  "private": true,
  "description": "Merchant Route - Post-Collapse Top-Down Tactical RPG & Caravan Trade Simulator",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node desktop/serve.cjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "electron .",
    "package:win": "npm run build && node desktop/prepare.cjs && electron-builder --win portable --x64"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "main": "electron/main.cjs",
  "author": "Merchant Route",
  "build": {
    "appId": "com.merchantroute.game",
    "productName": "Merchant Route",
    "directories": {
      "output": "release-final",
      "app": ".desktop-build"
    },
    "files": [
      "out/**/*",
      "electron/main.cjs",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "MerchantRoute-${version}-portable.exe"
    },
    "compression": "normal"
  }
}
